# Core model providers
OPENAI_API_KEY=
OPENAI_TIMEOUT_SEC=120
# Preferred Google API key name; GEMINI_API_KEY is still accepted as a fallback.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Vector store
PINECONE_API_KEY=
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
# Read-only runtime DSN. Production must use TLS and the dedicated reader role.
PGVECTOR_DSN=postgresql://mbzuai_retriever:REPLACE_ME@10.10.0.10:5432/mbzuai_vectors?sslmode=verify-full
# Indexing-only DSN. Do not expose this writer credential to the chatbot.
PGVECTOR_INGEST_DSN=postgresql://mbzuai_indexer:REPLACE_ME@10.10.0.10:5432/mbzuai_vectors?sslmode=verify-full

# Graph store
NEO4J_URI=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_NAMESPACE=

# Optional language detector model
FASTTEXT_LID_MODEL=

# Example config overrides
# PIPELINE_CRAWLER__START_URL=https://mbzuai.ac.ae
# PIPELINE_CRAWLER__MAX_PAGES=1200
# PIPELINE_GRAPH__NEO4J_NAMESPACE=my-project:run-id
