# Core model providers
OPENAI_API_KEY=
OPENAI_TIMEOUT_SEC=120
GEMINI_API_KEY=

# Vector store
PINECONE_API_KEY=

# Graph store
NEO4J_URI=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_NAMESPACE=

# Dashboard frontend overrides
NEXT_PUBLIC_API_URL=http://127.0.0.1:8050
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8050

# Optional language detector model
FASTTEXT_LID_MODEL=

