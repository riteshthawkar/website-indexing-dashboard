# Runtime retriever identity and release contract.
SERVICE_ENVIRONMENT=production
LOG_FORMAT=json
PIPELINE_CONFIG=mbzuai_preprod_pinecone_production
RELEASE_COMMIT_SHA=
RELEASE_PROJECT_NAME=mbzuai_main
ACTIVE_RELEASE_FILE=/data/releases/mbzuai_main/active_release.json
RELEASE_RUNS_ROOT=/data/releases/runs/mbzuai_main
RETRIEVER_EXPECTED_EMBEDDING_MODEL=gemini-embedding-2
RETRIEVER_EXPECTED_EMBEDDING_DIMENSIONALITY=1536
RETRIEVER_REQUIRE_GRAPH=true
RETRIEVER_ALLOW_WAIVED_RELEASE=false
# Must exactly match the backend's dedicated 32+ character random value.
RETRIEVAL_SERVICE_TOKEN=
RETRIEVER_STARTUP_PROBE_REQUIRED=true
RETRIEVER_STARTUP_PROBE_QUERY=Where is MBZUAI located?
RETRIEVER_STARTUP_PROBE_TIMEOUT_SECONDS=120

# Recommended Droplet + Volume mode. Provisioning must create this marker on
# the mounted volume; it is deliberately absent from the container image.
RELEASE_STORAGE_MODE=persistent
RELEASE_STORAGE_MARKER_FILE=/data/releases/.mbzuai-release-storage
RETRIEVER_REQUIRE_STORAGE_MARKER=true

# App Platform alternative (no volumes): set RELEASE_STORAGE_MODE=hydrate and
# populate the immutable object identity, exact HTTPS endpoint, region,
# read-only object credentials, SHA256, and endpoint hostname allowlist.
RELEASE_ARCHIVE_S3_URI=
RELEASE_ARCHIVE_S3_ENDPOINT_URL=
RELEASE_ARCHIVE_S3_REGION=
RELEASE_ARCHIVE_S3_ACCESS_KEY_ID=
RELEASE_ARCHIVE_S3_SECRET_ACCESS_KEY=
RELEASE_ARCHIVE_SHA256=
RELEASE_ARCHIVE_ALLOWED_HOSTS=
RELEASE_ARCHIVE_TIMEOUT_SECONDS=300
RELEASE_ARCHIVE_MAX_BYTES=2147483648
RELEASE_ARCHIVE_MAX_EXTRACTED_BYTES=4294967296
RELEASE_ARCHIVE_MAX_FILES=64
RELEASE_ARCHIVE_ALLOW_HTTP=false
RELEASE_ARCHIVE_ALLOW_REPLACE=false

# Retriever server limits.
RETRIEVER_HOST=0.0.0.0
RETRIEVER_PORT=8060
RETRIEVER_MAX_CONCURRENCY=2
RETRIEVER_REQUEST_TIMEOUT_SECONDS=110
RETRIEVER_QUEUE_TIMEOUT_SECONDS=10

# Provider credentials. Populate them only in the deployment control plane.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Pinecone belongs only on the private retriever/indexing worker. The public
# backend continues to call the authenticated retrieval service and never sees
# this credential.
PINECONE_API_KEY=

# Release-promotion candidate attestation (ops-only image/profile).
CANDIDATE_BACKEND_OPERATIONS_TOKEN=
CANDIDATE_BACKEND_COMMIT_SHA=
CANDIDATE_RETRIEVER_ATTESTATION_URL=http://retriever-candidate:8060/attestationz
CANDIDATE_BACKEND_DETAILED_URL=http://backend-candidate:8080/health/detailed
CANDIDATE_ATTESTATION_TIMEOUT_SECONDS=30
