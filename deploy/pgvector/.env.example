# Non-secret Docker Compose settings. Copy to .env on the pgvector Droplet.
PGVECTOR_BIND_IP=10.10.0.10
# Comma-separated private VPC ranges for App Platform and the indexing worker.
PGVECTOR_ALLOWED_CIDRS=10.10.0.0/20
PGVECTOR_DATA_DIR=/mnt/mbzuai-pgvector/postgres
PGVECTOR_TLS_DIR=/etc/mbzuai-pgvector/tls
PGVECTOR_POSTGRES_PASSWORD_FILE=/etc/mbzuai-pgvector/secrets/postgres_password
PGVECTOR_READER_PASSWORD_FILE=/etc/mbzuai-pgvector/secrets/reader_password
PGVECTOR_WRITER_PASSWORD_FILE=/etc/mbzuai-pgvector/secrets/writer_password

PGVECTOR_DATABASE=mbzuai_vectors
PGVECTOR_ADMIN_USER=mbzuai_pgadmin
PGVECTOR_READER_USER=mbzuai_retriever
PGVECTOR_WRITER_USER=mbzuai_indexer
PGVECTOR_READER_CONNECTION_LIMIT=24
PGVECTOR_WRITER_CONNECTION_LIMIT=8
PGVECTOR_MAX_CONNECTIONS=100

# Starting point for a 2-vCPU / 4-GB Droplet. Re-benchmark before changing.
PGVECTOR_CPU_LIMIT=2.0
PGVECTOR_MEMORY_LIMIT=4g
PGVECTOR_SHM_SIZE=1gb
PGVECTOR_SHARED_BUFFERS=1GB
PGVECTOR_EFFECTIVE_CACHE_SIZE=3GB
PGVECTOR_MAINTENANCE_WORK_MEM=512MB
PGVECTOR_WORK_MEM=16MB
